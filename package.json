{
  "name": "tailwind-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run test:unit",
    "dev:fixture": "node scripts/fixture.mjs dev",
    "build:fixture": "node scripts/fixture.mjs build",
    "start:fixture": "node scripts/fixture.mjs start",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build:fixture && npm run test:browser"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@headlessui/react": "^2.2.9",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "contentful": "^11.12.9",
    "framer-motion": "^13.2.0",
    "next": "^16.2.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.14.0"
  }
}
