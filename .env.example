# Copy to .env.local. No accounts are needed with this explicitly enabled.
# NEXT_PUBLIC_* values are embedded at build time: restart/rebuild after changes.
NEXT_PUBLIC_FIXTURE_MODE=true

# Live mode: set the flag above to false and supply a Contentful Delivery API key.
# Server-only values. Do not use a Content Management API token.
# Rename legacy NEXT_PUBLIC_CONTENTFUL_* variables; those names are not read.
# See docs/CONTENT_FETCHING.md for freshness, pagination, and failure behavior.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=

# EmailJS browser integration (required only to send real mail in live mode).
# These identifiers/public key are intentionally public, not secret API keys.
NEXT_PUBLIC_SERVICE_ID=
NEXT_PUBLIC_TEMPLATE_ID=
NEXT_PUBLIC_USER_ID=

# Optional Google Search Console verification value (content attribute only).
NEXT_PUBLIC_GSC_TOKEN=
